# Cloudflare Pages response headers.
#
# Hashed build assets are immutable and can be cached forever; index.html must
# never be cached or a deploy would keep serving references to deleted bundles.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  # The app ships no inline scripts and loads nothing third-party, so the
  # policy can stay strict. Shiki styling is precomputed, so no
  # style-src 'unsafe-inline' is needed for the token colours.
  Content-Security-Policy: default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'none'
